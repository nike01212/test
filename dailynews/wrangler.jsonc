{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dailynews",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"workers_dev": true,
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		// 每個請求都先經過 Worker 檢查密碼，靜態頁面才不會被直接打開
		"run_worker_first": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "dailynews",
			// 第一次部署時 wrangler 會自動建立資料庫，並把 database_id 寫回這裡
			"migrations_dir": "migrations",
			"database_id": "4a884119-e9d6-4ff6-92ff-046bfc3aca75"
		}
	],
	"observability": {
		"enabled": true
	},
	"triggers": {
		// 時間都是 UTC（台北減 8 小時），src/index.ts 的 scheduled 依 cron 分開處理：
		// - 0 19 * * *：每天台北 03:00 清掉超過 180 天的圖片全文
		// - 30 6,8,10,12,14,23 * * *：台北 14:30、16:30、18:30、20:30、22:30、隔天 07:30 收盤比對：
		//   先存前一個交易日的上櫃收盤快照（全部上櫃股，存過就跳過）；再比對現在貼會歸到的那一頁清單上，
		//   還沒比對過的個股，前一個交易日收盤有沒有漲停（送出新聞後網頁也會馬上要求比對，這裡是補漏）
		"crons": ["0 19 * * *", "30 6,8,10,12,14,23 * * *"]
	},
	// 群組密碼不放在這裡：用 `npx wrangler secret put GROUP_PASSWORD` 設定
	"env": {
		// 測試站 https://dailynews-staging.tw-notes-8317.workers.dev（2026/10/24 起正式站給群組用，所有修改先上這裡給發起人確認）
		// 部署：npm run deploy:staging。程式、靜態檔、排程和正式站一樣（沒寫的設定沿用上面）；
		// 資料庫另外一個，密碼另外設：npx wrangler secret put GROUP_PASSWORD --env staging
		"staging": {
			"name": "dailynews-staging",
			// 畫面左上角的網站名稱換成這個，一看就知道是測試站（正式站沒設，照 index.html 原本的字）
			"vars": {
				"SITE_BRAND": "盤後新聞標的整理 - 測試站"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "dailynews-staging",
					"migrations_dir": "migrations",
					"database_id": "11c8072e-25b5-4a3e-8d60-f4703c1c9a13"
				}
			]
		}
	}
}